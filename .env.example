# ==============================================================================
# Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e preencha com seus valores locais:
#   cp .env.example .env
# NUNCA envie senhas, chaves de API ou segredos reais para o Git!
# ==============================================================================

# Aplicação
PORT=3000
NODE_ENV=development
APP_NAME=MeuProjeto
APP_URL=http://localhost:3000

# Banco de Dados (exemplo)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=meu_banco
# DB_USER=postgres
# DB_PASSWORD=seu_segredo_aqui

# Autenticação e Segurança
# JWT_SECRET=chave_secreta_para_desenvolvimento
# SESSION_SECRET=chave_secreta_da_sessao

# Integrações / APIs Externas (coloque apenas chaves de teste ou deixe vazio)
# API_KEY=
